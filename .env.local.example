# DB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# KMA API
KMA_API_KEY=

# AirKorea API
AIRKOREA_API_KEY=

# Toss Payments
# NEXT_PUBLIC_ 접두 — 브라우저에서 토스 결제 SDK loadTossPayments(clientKey)에 사용
# (소라 결제 페이지에서 import. 서버에서도 process.env로 동일 접근 가능)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 서버 전용 — 결제 confirm API 호출 시 Basic Auth (lib/toss.ts, payments/confirm)
TOSS_SECRET_KEY=

# Scheduler security key
SCHEDULER_SECRET=
