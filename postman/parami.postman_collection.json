{
  "info": {
    "name": "Parami API",
    "description": "auth / plans / payments / subscriptions / admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "test@a.com" },
    { "key": "password", "value": "1234" },
    { "key": "adminEmail", "value": "admin@a.com" },
    { "key": "adminPassword", "value": "1234" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"테스트유저\"\n}"
            }
          }
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "2. Plans",
      "item": [
        {
          "name": "list",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/plans" }
        }
      ]
    },
    {
      "name": "3. Payments",
      "item": [
        {
          "name": "confirm (실결제 paymentKey 필요)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/payments/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentKey\": \"토스위젯에서받은key\",\n  \"orderId\": \"order_test_001\",\n  \"amount\": 7400,\n  \"tier\": \"basic\"\n}"
            }
          }
        },
        {
          "name": "me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/me" }
        }
      ]
    },
    {
      "name": "4. Subscriptions",
      "item": [
        {
          "name": "me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/subscriptions/me" }
        },
        {
          "name": "change-tier",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/subscriptions/change-tier",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tier\": \"premium\"\n}"
            }
          }
        },
        {
          "name": "cancel",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/subscriptions/cancel" }
        }
      ]
    },
    {
      "name": "5. Admin (role=admin 필요)",
      "item": [
        { "name": "users",         "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/users" } },
        { "name": "subscriptions", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/subscriptions" } },
        { "name": "payments",      "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/payments" } },
        { "name": "triggers",      "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/triggers" } },
        { "name": "rewards",       "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/rewards" } }
      ]
    }
  ]
}
